<IfModule mod_rewrite.c>
  # ANGULAR EN APACHE: LAS RUTAS (/app/hato, /app/potreros...) LAS RESUELVE ANGULAR, NO SON CARPETAS REALES
  # -Indexes: NO MOSTRAR LA LISTA DE ARCHIVOS DE UNA CARPETA. /api/... NO PASA POR AQUI (LO ATIENDE EL PROXY DEL SITIO)
  Options -Indexes +FollowSymLinks
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>
